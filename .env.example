# Form delivery via Resend (https://resend.com) — set these in Vercel too:
# Project → Settings → Environment Variables

# Required. Create under resend.com → API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Optional. Inbox that receives leads (defaults to the site email in src/data/site.ts).
LEAD_TO_EMAIL=contact@reliant-development.com

# Optional. Must be an address on a domain verified in Resend.
# Until a domain is verified, the default onboarding@resend.dev sender only
# delivers to the Resend account owner's own email.
LEAD_FROM_EMAIL="Reliant Development <leads@reliant-development.com>"
