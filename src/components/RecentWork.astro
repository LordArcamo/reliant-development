---
// Real Reliant job-site photography (client-supplied, Sep 2026).
const slots = [
  {
    src: '/images/projects/project-siding.jpg',
    alt: 'Siding installation in progress on a home exterior with pump-jack scaffolding',
    label: 'Siding & exteriors',
    meta: 'Residential',
    tall: true,
  },
  {
    src: '/images/projects/project-fitout.jpg',
    alt: 'Crew installing wall sheathing during an interior fit-out',
    label: 'Fit-out framing',
    meta: 'Commercial',
    tall: false,
  },
  {
    src: '/images/projects/project-addition.jpg',
    alt: 'Exterior wall opening framed and prepped during an addition',
    label: 'Additions & openings',
    meta: 'Residential',
    tall: false,
  },
  {
    src: '/images/projects/project-framing.jpg',
    alt: 'Framed interior with insulation installed between studs',
    label: 'Framing & insulation',
    meta: 'Residential',
    tall: true,
  },
];
---

<section id="our-work" class="mx-auto max-w-site px-5 py-20 lg:px-8 lg:py-28">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="eyebrow">The work</p>
      <h2 class="display mt-4 text-[clamp(1.9rem,4vw,2.9rem)]">Work that outlasts the warranty.</h2>
    </div>
    <p class="max-w-sm text-[0.9rem] leading-relaxed text-ink-500">
      Shot on our job sites. More projects land here as they wrap.
    </p>
  </div>
  <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
    {
      slots.map((s) => (
        <figure class:list={['group relative overflow-hidden border border-ink-900/10 bg-paper-soft', 'aspect-[3/4]', !s.tall && 'sm:mt-10']}>
          <img
            src={s.src}
            alt={s.alt}
            loading="lazy"
            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
          />
          <figcaption class="absolute inset-x-0 bottom-0 border-t border-ink-900/10 bg-paper/95 p-4 backdrop-blur-sm">
            <p class="font-display text-[0.95rem] font-bold">{s.label}</p>
            <p class="mt-0.5 font-mono text-[0.62rem] uppercase tracking-[0.18em] text-ink-500">{s.meta}</p>
          </figcaption>
          <div class="absolute inset-x-0 top-0 h-[3px] bg-brand opacity-0 transition-opacity duration-300 group-hover:opacity-100" />
        </figure>
      ))
    }
  </div>
</section>
